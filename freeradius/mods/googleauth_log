# radius-manager: 記錄 Google 帳號登入成功。格式：epoch|hex(帳號)|裝置 MAC|封包來源 IP|NAS-IP-Address|Called-Station-Id（SSID 可能含 |，必須放最後）
linelog googleauth_log {
	filename = ${logdir}/macauth/google-%Y%m%d.log
	escape_filenames = no
	permissions = 0640
	format = "%l|%{hex:&session-state:Tmp-String-4}|%{Calling-Station-Id}|%{%{Packet-Src-IP-Address}:-%{Packet-Src-IPv6-Address}}|%{%{NAS-IP-Address}:-%{NAS-IPv6-Address}}|%{Called-Station-Id}"
}
