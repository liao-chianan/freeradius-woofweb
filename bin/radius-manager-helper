#!/usr/bin/python3 -I
"""Privileged half of radius-manager. The web service runs unprivileged and drops JSON
requests into a spool directory; a systemd path unit runs this helper as root.

Every request comes from a less privileged process, so all input is validated here
again. External commands never go through a shell and secrets never go on a command line.

  radius-manager-helper process   handle queued requests
  radius-manager-helper render    install FreeRADIUS templates (install and upgrade)
"""
import datetime
import hashlib
import hmac
import grp
import ipaddress
import json
import os
import pwd
import re
import secrets
import shutil
import socket
import stat
import string
import struct
import subprocess
import sys
import tempfile
import time
import urllib.parse

APP_ROOT = os.environ.get('RADMGR_ROOT', '/opt/radius-manager/current')
SERVICE_USER = 'radmgr'
STATE_DIR = '/var/lib/radius-manager'
REQUEST_DIR = f'{STATE_DIR}/requests'
RESULT_DIR = f'{STATE_DIR}/results'
ROOT_STATE = '/var/lib/radius-manager-root/state.json'
RADDB = '/etc/freeradius/3.0'
CLIENTS = f'{RADDB}/clients.conf'
EAP_CERT_DIR = f'{RADDB}/certs/radius-manager'
EAP_CERT = f'{EAP_CERT_DIR}/fullchain.pem'
EAP_KEY = f'{EAP_CERT_DIR}/privkey.pem'
LDAP_CONF = f'{RADDB}/ldap-google.conf'
LDAP_CERT = f'{RADDB}/certs/ldap-client.crt'
LDAP_KEY = f'{RADDB}/certs/ldap-client.key'
WEB_TLS_DIR = '/etc/radius-manager/tls'
SMB_CONF = '/etc/samba/smb.conf'
PROXY_CONF = f'{RADDB}/proxy.conf'
# Read by radius-proxy-pap (runs as freerad) for the PAP and GTC methods.
PROXY_JSON = f'{RADDB}/radius-manager-proxy.json'
PROXY_REALM = 'radmgr_proxy'
KRB5_CONF = '/etc/krb5.conf'
MAX_REQUEST = 1024 * 1024
RESULT_MAX_AGE = 3600
ENABLED_MODS = ('adauth_log', 'device_limit', 'failauth_log', 'googleauth_log', 'group_policy', 'ldap_google', 'macauth_log', 'proxy_filter',
                'proxy_pap', 'proxyauth_log', 'ssid_policy')
TEMPLATE_MODS = ENABLED_MODS + ('eap', 'files', 'mschap')

DOMAIN_RE = re.compile(r'(?=.{1,253}$)([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,63}')
HOST_RE = re.compile(r'(?=.{1,253}$)[A-Za-z0-9]([A-Za-z0-9.-]{0,251}[A-Za-z0-9])?')
WORKGROUP_RE = re.compile(r'[A-Za-z0-9][A-Za-z0-9-]{0,14}')
COMPUTER_RE = re.compile(r'[A-Za-z0-9][A-Za-z0-9-]{0,14}')
ACCOUNT_RE = re.compile(r'[^\s"\\/\[\]:;|=,+*?<>@]{1,64}')
EMAIL_RE = re.compile(r'[^\s@"\\|]{1,64}@[A-Za-z0-9.-]{1,190}')
SECRET_RE = re.compile(r'[A-Za-z0-9._~-]{8,64}')
# Written inside single quotes in proxy.conf, where FreeRADIUS does no ${} expansion; ' and \ are refused.
PROXY_SECRET_RE = re.compile(r"[\x21-\x7e]{6,128}")
DN_RE = re.compile(r'(dc=[A-Za-z0-9-]{1,63},)*dc=[A-Za-z0-9-]{1,63}', re.I)


class Refused(Exception):
    """The request is invalid or the action failed; the message is shown to the administrator."""


class Steps:
    def __init__(self):
        self.items = []

    def add(self, name, ok, detail='', ok_detail=''):
        self.items.append({'name': name, 'ok': bool(ok), 'detail': str(detail if not ok else ok_detail)[:600]})
        return ok


def run(cmd, timeout=60, env=None, stdin=None):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, errors='replace', timeout=timeout, input=stdin,
                              env={**os.environ, 'LC_ALL': 'C.UTF-8', 'LANG': 'C.UTF-8', **(env or {})})
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(cmd, 124, '', f'timed out after {timeout} seconds')
    except OSError as e:
        return subprocess.CompletedProcess(cmd, 127, '', str(e))


def output_tail(result, limit=400):
    text = (result.stderr or result.stdout or '').strip()
    return text[-limit:]


def load_state():
    try:
        with open(ROOT_STATE, encoding='utf-8') as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_state(state):
    os.makedirs(os.path.dirname(ROOT_STATE), mode=0o700, exist_ok=True)
    write_file(ROOT_STATE, json.dumps(state, indent=1).encode(), 0o600, 'root', 'root')


def write_file(path, data, mode, owner='root', group='freerad'):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix='.radmgr-')
    try:
        with os.fdopen(fd, 'wb') as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.chown(tmp, pwd.getpwnam(owner).pw_uid, grp.getgrnam(group).gr_gid)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except Exception:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def read_bytes(path):
    try:
        with open(path, 'rb') as f:
            return f.read()
    except FileNotFoundError:
        return None


class Transaction:
    """Writes config files, then requires `freeradius -C` to pass; the old files come back on any failure."""

    def __init__(self):
        self.saved = {}

    def write(self, path, data, mode=0o640, owner='root', group='freerad'):
        if path not in self.saved:
            self.saved[path] = (read_bytes(path), os.stat(path) if os.path.exists(path) else None)
        write_file(path, data, mode, owner, group)

    def rollback(self):
        for path, (old, st) in self.saved.items():
            if old is None:
                if os.path.exists(path):
                    os.unlink(path)
            else:
                write_file(path, old, stat.S_IMODE(st.st_mode), pwd.getpwuid(st.st_uid).pw_name, grp.getgrgid(st.st_gid).gr_name)


def config_error():
    result = run(['/usr/sbin/freeradius', '-Cx', '-lstdout'], timeout=60)
    if result.returncode == 0:
        return ''
    lines = [line for line in (result.stdout + result.stderr).splitlines() if 'rror' in line]
    return '\n'.join(lines[-5:])[:600] or 'freeradius config check failed'


def restart_freeradius():
    result = run(['systemctl', 'restart', 'freeradius'], timeout=60)
    return result.returncode == 0 and run(['systemctl', 'is-active', '--quiet', 'freeradius']).returncode == 0


def commit_freeradius(tx):
    error = config_error()
    if error:
        tx.rollback()
        raise Refused(f'FreeRADIUS 設定檢查失敗，已還原：{error}')
    if not restart_freeradius():
        tx.rollback()
        restart_freeradius()
        raise Refused('FreeRADIUS 重新啟動失敗，已還原設定')


def text_param(params, key, pattern=None, required=True, maximum=256):
    value = params.get(key, '')
    if not isinstance(value, str):
        raise Refused(f'{key} 格式錯誤')
    value = value.strip()
    if not value:
        if required:
            raise Refused(f'缺少 {key}')
        return ''
    if len(value) > maximum or any(ord(c) < 32 or ord(c) == 127 for c in value):
        raise Refused(f'{key} 含有不允許的字元')
    if pattern and not pattern.fullmatch(value):
        raise Refused(f'{key} 格式錯誤')
    return value


def password_param(params, key, required=True):
    value = params.get(key, '')
    if not isinstance(value, str):
        raise Refused(f'{key} 格式錯誤')
    if not value:
        if required:
            raise Refused(f'缺少 {key}')
        return ''
    if len(value) > 256 or any(ord(c) < 32 or ord(c) == 127 for c in value):
        raise Refused(f'{key} 含有不允許的字元')
    return value


def tcp_open(host, port, timeout=4):
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except OSError:
        return False


def x509_summary(pem_path):
    result = run(['openssl', 'x509', '-in', pem_path, '-noout', '-subject', '-enddate', '-ext', 'subjectAltName'], timeout=10)
    return result.stdout.strip() if result.returncode == 0 else ''


def validate_cert_pair(cert_pem, key_pem):
    """Returns (certificate, key) as bytes after checking they parse, match and are not expired."""
    if not cert_pem or not key_pem:
        raise Refused('請提供憑證與私鑰')
    with tempfile.TemporaryDirectory(dir='/run') as tmp:
        cert = os.path.join(tmp, 'cert.pem')
        key = os.path.join(tmp, 'key.pem')
        write_file(cert, cert_pem.encode(), 0o600, 'root', 'root')
        write_file(key, key_pem.encode(), 0o600, 'root', 'root')
        if run(['openssl', 'x509', '-in', cert, '-noout'], timeout=10).returncode != 0:
            raise Refused('憑證不是有效的 PEM 格式')
        if run(['openssl', 'pkey', '-in', key, '-noout', '-passin', 'pass:'], timeout=10).returncode != 0:
            raise Refused('私鑰不是有效的 PEM 格式，或有設定密碼')
        cert_pub = run(['openssl', 'x509', '-in', cert, '-noout', '-pubkey'], timeout=10)
        key_pub = run(['openssl', 'pkey', '-in', key, '-pubout', '-passin', 'pass:'], timeout=10)
        if cert_pub.stdout.strip() != key_pub.stdout.strip():
            raise Refused('憑證與私鑰不是同一組')
        if run(['openssl', 'x509', '-in', cert, '-noout', '-checkend', '86400'], timeout=10).returncode != 0:
            raise Refused('憑證已過期或將在 24 小時內到期')
    return cert_pem.encode(), key_pem.encode()


def self_signed(fqdn, ips=(), days=825):
    with tempfile.TemporaryDirectory(dir='/run') as tmp:
        cert, key = os.path.join(tmp, 'c.pem'), os.path.join(tmp, 'k.pem')
        san = ','.join([f'DNS:{fqdn}'] + [f'IP:{ip}' for ip in ips])
        result = run(['openssl', 'req', '-x509', '-newkey', 'ec', '-pkeyopt', 'ec_paramgen_curve:prime256v1', '-nodes', '-sha256', '-days', str(days),
                      '-keyout', key, '-out', cert, '-subj', f'/CN={fqdn}', '-addext', f'subjectAltName={san}'], timeout=30)
        if result.returncode != 0:
            raise Refused(f'無法產生憑證：{output_tail(result)}')
        return read_bytes(cert), read_bytes(key)


def clients_conf(secret, networks, local_secret):
    lines = ['# Managed by radius-manager. Change it in the web interface: Settings > System.', '',
             'client localhost {', '\tipaddr = 127.0.0.1', f'\tsecret = {local_secret}', '\trequire_message_authenticator = no', '}', '']
    for index, network in enumerate(networks):
        net = ipaddress.ip_network(network, strict=False)
        lines += [f'client radmgr_{index} {{', f"\t{'ipaddr' if net.version == 4 else 'ipv6addr'} = {net}", f'\tsecret = {secret}', '}', '']
    return '\n'.join(lines).encode()


def action_radius_clients(params):
    secret = text_param(params, 'secret', SECRET_RE)
    networks = params.get('networks')
    if not isinstance(networks, list) or not 1 <= len(networks) <= 50:
        raise Refused('請提供 1 到 50 個網段')
    clean = []
    for network in networks:
        try:
            clean.append(str(ipaddress.ip_network(str(network), strict=False)))
        except ValueError:
            raise Refused(f'網段格式錯誤：{network}')
    state = load_state()
    local = state.setdefault('local_secret', secrets.token_hex(16))
    tx = Transaction()
    tx.write(CLIENTS, clients_conf(secret, clean, local))
    commit_freeradius(tx)
    save_state(state)
    return {'message': 'RADIUS 用戶端設定已套用，FreeRADIUS 已重新啟動', 'networks': clean}


def action_timezone(params):
    tz = text_param(params, 'timezone', re.compile(r'[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+){0,2}'), maximum=64)
    if not os.path.isfile(os.path.join('/usr/share/zoneinfo', tz)):
        raise Refused(f'不是有效的時區：{tz}')
    result = run(['timedatectl', 'set-timezone', tz], timeout=20)
    if result.returncode != 0:
        raise Refused(f'無法設定時區：{output_tail(result)}')
    return {'message': f'時區已設為 {tz}'}


def mschap_text(workgroup):
    with open(os.path.join(APP_ROOT, 'freeradius/mods/mschap'), encoding='utf-8') as f:
        return f.read().replace('@@AD_WORKGROUP@@', workgroup).encode()


def samba_text(workgroup, realm, dc, computer):
    lines = ['# Managed by radius-manager.', '[global]', '   security = ADS', f'   workgroup = {workgroup}', f'   realm = {realm}',
             '   log file = /var/log/samba/%m.log', '   log level = 1', '   winbind use default domain = true', '   winbind offline logon = false',
             '   template homedir = /home/%U', '   template shell = /bin/false', '   idmap config * : backend = tdb', '   idmap config * : range = 10000-20000']
    if computer:
        lines.insert(5, f'   netbios name = {computer}')
    if dc:
        lines.insert(5, f'   password server = {dc}')
    return ('\n'.join(lines) + '\n').encode()


def krb5_text(realm, dc):
    text = f'[libdefaults]\n\tdefault_realm = {realm}\n\tdns_lookup_realm = false\n\tdns_lookup_kdc = true\n'
    if dc:
        text += f'\n[realms]\n\t{realm} = {{\n\t\tkdc = {dc}\n\t\tadmin_server = {dc}\n\t}}\n'
    return text.encode()


def join_hint(text):
    lowered = text.lower()
    if 'clock skew' in lowered or 'time' in lowered and 'skew' in lowered:
        return '主機與 AD 時間差太多，請先校時。'
    if 'logon failure' in lowered or 'preauthentication failed' in lowered or 'invalid credentials' in lowered:
        return 'AD 管理帳號或密碼錯誤。'
    if 'access denied' in lowered or 'insufficient' in lowered:
        return '這個帳號沒有把電腦加入網域的權限。'
    if 'no logon servers' in lowered or 'cannot find' in lowered or "couldn't find" in lowered or 'failed to find' in lowered:
        return '找不到網域控制站：請確認 DNS 指向 AD，或填寫網域控制站位址。'
    return ''


def ad_verify(steps, test_user, test_password):
    result = run(['net', 'ads', 'testjoin'], timeout=30)
    if not steps.add('確認主機仍在網域內', result.returncode == 0, output_tail(result)):
        return False
    ok = False
    for _ in range(10):
        result = run(['wbinfo', '-t'], timeout=20)
        if result.returncode == 0:
            ok = True
            break
        time.sleep(2)
    if not steps.add('winbind 與網域控制站的信任關係', ok, '' if ok else output_tail(result)):
        return False
    result = run(['wbinfo', '-u'], timeout=60)
    users = [line for line in result.stdout.splitlines() if line.strip()]
    steps.add('讀取 AD 帳號', result.returncode == 0, output_tail(result), f'{len(users)} 個帳號')
    if test_user:
        line = f"{urllib.parse.quote(test_user, safe='')} {urllib.parse.quote(test_password, safe='')}\n"
        result = run(['ntlm_auth', '--helper-protocol=squid-2.5-basic'], timeout=20, stdin=line)
        accepted = result.stdout.strip().startswith('OK')
        if not steps.add(f'測試帳號 {test_user} 登入', accepted, '' if accepted else '帳號或密碼錯誤，或帳號已停用'):
            return False
    return True


def action_ad_join(params):
    realm = text_param(params, 'realm', DOMAIN_RE).upper()
    workgroup = text_param(params, 'workgroup', WORKGROUP_RE).upper()
    dc = text_param(params, 'dc', HOST_RE, required=False)
    computer = text_param(params, 'computer', COMPUTER_RE, required=False).upper()
    admin_user = text_param(params, 'admin_user', ACCOUNT_RE)
    admin_password = password_param(params, 'admin_password')
    test_user = text_param(params, 'test_user', ACCOUNT_RE, required=False)
    test_password = password_param(params, 'test_password', required=bool(test_user))
    steps = Steps()
    target = dc or realm.lower()
    try:
        address = socket.getaddrinfo(target, None)[0][4][0]
    except OSError as e:
        steps.add(f'解析 {target}', False, f'{e}。主機的 DNS 需要能解析 AD 網域，或填寫網域控制站 IP。')
        return {'ok': False, 'steps': steps.items}
    steps.add(f'解析 {target}', True, ok_detail=address)
    closed = [port for port in (88, 389, 445) if not tcp_open(target, port)]
    if not steps.add('連線網域控制站（TCP 88、389、445）', not closed, f'連不上：{closed}' if closed else ''):
        return {'ok': False, 'steps': steps.items}
    saved = {path: read_bytes(path) for path in (SMB_CONF, KRB5_CONF)}
    tx = Transaction()

    def undo():
        for path, data in saved.items():
            if data is None:
                if os.path.exists(path):
                    os.unlink(path)
            else:
                write_file(path, data, 0o644, 'root', 'root')
        run(['systemctl', 'restart', 'winbind'], timeout=30)

    write_file(SMB_CONF, samba_text(workgroup, realm, dc, computer), 0o644, 'root', 'root')
    write_file(KRB5_CONF, krb5_text(realm, dc), 0o644, 'root', 'root')
    with tempfile.NamedTemporaryFile('w', dir='/run', prefix='.radmgr-auth-', encoding='utf-8') as auth:
        os.fchmod(auth.fileno(), 0o600)
        auth.write(f'username = {admin_user}\npassword = {admin_password}\ndomain = {workgroup}\n')
        auth.flush()
        result = run(['net', 'ads', 'join', '--no-dns-updates', '-A', auth.name], timeout=90)
    if result.returncode != 0:
        tail = output_tail(result)
        steps.add('把主機加入網域', False, f'{join_hint(tail)} {tail}'.strip())
        undo()
        return {'ok': False, 'steps': steps.items}
    steps.add('把主機加入網域', True)
    run(['systemctl', 'enable', 'winbind'], timeout=30)
    result = run(['systemctl', 'restart', 'winbind'], timeout=60)
    if not steps.add('啟動 winbind', result.returncode == 0, output_tail(result)):
        undo()
        return {'ok': False, 'steps': steps.items}
    if not ad_verify(steps, test_user, test_password):
        return {'ok': False, 'steps': steps.items, 'joined': True}
    state = load_state()
    state['ad_workgroup'] = workgroup
    tx.write(f'{RADDB}/mods-available/mschap', mschap_text(workgroup))
    try:
        commit_freeradius(tx)
    except Refused as e:
        steps.add('套用到 FreeRADIUS', False, e)
        return {'ok': False, 'steps': steps.items, 'joined': True}
    steps.add('套用到 FreeRADIUS', True)
    save_state(state)
    run(['systemctl', 'enable', '--now', 'radius-manager-ad-status.timer', 'radius-manager-ad-status.path'], timeout=30)
    run(['systemctl', 'start', '--no-block', 'radius-manager-ad-status.service'], timeout=15)
    return {'ok': True, 'steps': steps.items}


def action_ad_test(params):
    test_user = text_param(params, 'test_user', ACCOUNT_RE, required=False)
    test_password = password_param(params, 'test_password', required=bool(test_user))
    steps = Steps()
    return {'ok': ad_verify(steps, test_user, test_password), 'steps': steps.items}


def action_ad_disable(params):
    run(['systemctl', 'disable', '--now', 'radius-manager-ad-status.timer', 'radius-manager-ad-status.path'], timeout=30)
    run(['systemctl', 'disable', '--now', 'winbind'], timeout=30)
    return {'ok': True, 'message': 'AD 帳號驗證已停用。AD 上的電腦帳號不會被刪除，需要時請由 AD 管理者移除。'}


def google_conf_text(identity, password, base_dn):
    return f'identity = "{identity}"\npassword = "{password}"\nbase_dn = "{base_dn}"\n'.encode()


def placeholder_ldap():
    return google_conf_text('not-configured', secrets.token_hex(16), 'dc=not,dc=configured')


def ldap_search(cert, key, args, identity=None, password=None, timeout=25):
    env = {'LDAPTLS_CERT': cert, 'LDAPTLS_KEY': key, 'LDAPTLS_REQCERT': 'demand'}
    with tempfile.NamedTemporaryFile('w', dir='/run', prefix='.radmgr-ldap-', encoding='utf-8') as pw:
        os.fchmod(pw.fileno(), 0o600)
        cmd = ['ldapsearch', '-LLL', '-x', '-o', 'nettimeout=10', '-o', 'ldif-wrap=no', '-H', 'ldaps://ldap.google.com:636']
        if identity:
            pw.write(password)
            pw.flush()
            cmd += ['-D', identity, '-y', pw.name]
        return run(cmd + args, timeout=timeout, env=env)


def google_verify(steps, cert, key, identity, password, base_dn, test_email, test_password):
    if not steps.add('連線 ldap.google.com:636', tcp_open('ldap.google.com', 636, 6), '主機無法連到 ldap.google.com:636'):
        return False
    result = ldap_search(cert, key, ['-z', '1', '-b', base_dn, '(objectClass=person)', 'dn'], identity, password)
    if result.returncode not in (0, 4):
        hint = '用戶端憑證或存取憑證有誤，或 LDAP 用戶端未開啟。' if result.returncode in (49, 13, 8, 1) else ''
        steps.add('以憑證查詢 Google 目錄', False, f'{hint} {output_tail(result)}'.strip())
        return False
    if not steps.add('以憑證查詢 Google 目錄', 'dn:' in result.stdout or 'dn::' in result.stdout,
                     '' if 'dn:' in result.stdout else '查得到伺服器但沒有任何使用者，請檢查 Base DN 與 LDAP 用戶端的讀取權限。'):
        return False
    if test_email:
        escaped = re.sub(r'([\\*()\0])', lambda m: '\\%02x' % ord(m.group(1)), test_email)
        result = ldap_search(cert, key, ['-b', base_dn, f'(mail={escaped})', 'dn'], identity, password)
        match = re.search(r'^(dn::? .+)$', result.stdout, re.M)
        if not steps.add(f'查詢測試帳號 {test_email}', bool(match), '' if match else '找不到這個帳號，或不在 LDAP 用戶端的讀取範圍內'):
            return False
        dn = match.group(1)
        if dn.startswith('dn:: '):
            import base64
            dn = base64.b64decode(dn[5:]).decode('utf-8', 'replace')
        else:
            dn = dn[4:]
        result = ldap_search(cert, key, ['-s', 'base', '-b', '', '(objectClass=*)', 'dn'], dn, test_password)
        if not steps.add(f'測試帳號 {test_email} 登入', result.returncode != 49, '帳號或密碼錯誤，或帳號不在「驗證使用者憑證」的範圍內' if result.returncode == 49 else ''):
            return False
    return True


def action_google_configure(params):
    identity = text_param(params, 'identity', re.compile(r'[^"\\$%\s]{1,128}'))
    password = text_param(params, 'password', re.compile(r'[^"\\$%\s]{1,128}'))
    base_dn = text_param(params, 'base_dn', DN_RE)
    test_email = text_param(params, 'test_email', EMAIL_RE, required=False)
    test_password = password_param(params, 'test_password', required=bool(test_email))
    cert_pem, key_pem = validate_cert_pair(params.get('cert_pem', ''), params.get('key_pem', ''))
    steps = Steps()
    with tempfile.TemporaryDirectory(dir='/run') as tmp:
        cert, key = os.path.join(tmp, 'c.crt'), os.path.join(tmp, 'c.key')
        write_file(cert, cert_pem, 0o600, 'root', 'root')
        write_file(key, key_pem, 0o600, 'root', 'root')
        if not google_verify(steps, cert, key, identity, password, base_dn, test_email, test_password):
            return {'ok': False, 'steps': steps.items}
    tx = Transaction()
    tx.write(LDAP_CONF, google_conf_text(identity, password, base_dn))
    tx.write(LDAP_CERT, cert_pem)
    tx.write(LDAP_KEY, key_pem)
    try:
        commit_freeradius(tx)
    except Refused as e:
        steps.add('套用到 FreeRADIUS', False, e)
        return {'ok': False, 'steps': steps.items}
    steps.add('套用到 FreeRADIUS', True)
    run(['systemctl', 'start', '--no-block', 'radius-manager-google-dir.service'], timeout=15)
    return {'ok': True, 'steps': steps.items, 'cert_expires': x509_summary(LDAP_CERT)}


def action_google_test(params):
    test_email = text_param(params, 'test_email', EMAIL_RE, required=False)
    test_password = password_param(params, 'test_password', required=bool(test_email))
    text = (read_bytes(LDAP_CONF) or b'').decode()
    values = dict(re.findall(r'^(identity|password|base_dn) = "(.*)"$', text, re.M))
    if len(values) != 3 or values['identity'] == 'not-configured':
        raise Refused('尚未設定 Google 帳號驗證')
    steps = Steps()
    ok = google_verify(steps, LDAP_CERT, LDAP_KEY, values['identity'], values['password'], values['base_dn'], test_email, test_password)
    return {'ok': ok, 'steps': steps.items, 'cert_expires': x509_summary(LDAP_CERT)}


def action_google_disable(params):
    cert, key = self_signed('not-configured.invalid', days=3650)
    tx = Transaction()
    tx.write(LDAP_CONF, placeholder_ldap())
    tx.write(LDAP_CERT, cert)
    tx.write(LDAP_KEY, key)
    commit_freeradius(tx)
    # 沒有設定時會刪除目錄快取，裡面有使用者姓名與 email
    run(['systemctl', 'start', '--no-block', 'radius-manager-google-dir.service'], timeout=15)
    return {'ok': True, 'message': 'Google 帳號驗證已停用，憑證與存取憑證已刪除'}


def action_eap_cert(params):
    mode = params.get('mode')
    if mode == 'self_signed':
        fqdn = text_param(params, 'fqdn', DOMAIN_RE)
        cert, key = self_signed(fqdn)
    elif mode == 'upload':
        cert, key = validate_cert_pair(params.get('cert_pem', ''), params.get('key_pem', ''))
    else:
        raise Refused('不支援的憑證方式')
    tx = Transaction()
    tx.write(EAP_CERT, cert)
    tx.write(EAP_KEY, key)
    commit_freeradius(tx)
    return {'ok': True, 'summary': x509_summary(EAP_CERT)}


def action_eap_cert_info(params):
    return {'ok': True, 'summary': x509_summary(EAP_CERT)}


def action_web_cert(params):
    cert, key = validate_cert_pair(params.get('cert_pem', ''), params.get('key_pem', ''))
    write_file(f'{WEB_TLS_DIR}/cert.pem', cert, 0o640, 'root', SERVICE_USER)
    write_file(f'{WEB_TLS_DIR}/key.pem', key, 0o640, 'root', SERVICE_USER)
    # Answer the browser first; the service restarts a few seconds later.
    run(['systemd-run', '--on-active=3', '--unit=radius-manager-web-cert-restart', 'systemctl', 'restart', 'radius-manager'], timeout=15)
    return {'ok': True, 'message': '管理介面憑證已更新，服務即將重新啟動，請稍後重新整理'}


def _md4(data):
    """MD4（RFC 1320）。OpenSSL 3 預設不提供 MD4，MS-CHAPv2 的密碼雜湊需要它。"""
    def rol(x, n):
        return ((x << n) | (x >> (32 - n))) & 0xffffffff
    msg = bytearray(data) + b'\x80'
    msg += b'\x00' * ((56 - len(msg) % 64) % 64) + struct.pack('<Q', len(data) * 8)
    h = [0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476]
    for off in range(0, len(msg), 64):
        x = struct.unpack('<16I', msg[off:off + 64])
        a, b, c, d = h
        for i in range(16):
            k, s = i, (3, 7, 11, 19)[i % 4]
            a, b, c, d = d, rol((a + ((b & c) | (~b & d)) + x[k]) & 0xffffffff, s), b, c
        for i in range(16):
            k, s = (i % 4) * 4 + i // 4, (3, 5, 9, 13)[i % 4]
            a, b, c, d = d, rol((a + ((b & c) | (b & d) | (c & d)) + x[k] + 0x5a827999) & 0xffffffff, s), b, c
        for i in range(16):
            k, s = (0, 8, 4, 12, 2, 10, 6, 14, 1, 9, 5, 13, 3, 11, 7, 15)[i], (3, 9, 11, 15)[i % 4]
            a, b, c, d = d, rol((a + (b ^ c ^ d) + x[k] + 0x6ed9eba1) & 0xffffffff, s), b, c
        h = [(v + n) & 0xffffffff for v, n in zip(h, (a, b, c, d))]
    return struct.pack('<4I', *h)


