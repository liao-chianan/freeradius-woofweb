def _permute(value, table, width):
    out = 0
    for pos in table:
        out = (out << 1) | ((value >> (width - pos)) & 1)
    return out


def _des_encrypt(key8, block8):
    """單一 DES-ECB 加密一個區塊，只供 MS-CHAPv2 計算 NT-Response。"""
    k = _permute(int.from_bytes(key8, 'big'), _PC1, 64)
    c, d = k >> 28, k & 0xfffffff
    subkeys = []
    for shift in _SHIFTS:
        c = ((c << shift) | (c >> (28 - shift))) & 0xfffffff
        d = ((d << shift) | (d >> (28 - shift))) & 0xfffffff
        subkeys.append(_permute((c << 28) | d, _PC2, 56))
    block = _permute(int.from_bytes(block8, 'big'), _IP, 64)
    left, right = block >> 32, block & 0xffffffff
    for subkey in subkeys:
        x = _permute(right, _E, 32) ^ subkey
        s = 0
        for i in range(8):
            six = (x >> (42 - 6 * i)) & 0x3f
            row, col = ((six & 0x20) >> 4) | (six & 1), (six >> 1) & 0xf
            s = (s << 4) | _S[i][row * 16 + col]
        left, right = right, left ^ _permute(s, _P, 32)
    return _permute((right << 32) | left, _FP, 64).to_bytes(8, 'big')


def _des_key(seven):
    bits = int.from_bytes(seven, 'big')
    return bytes((((bits >> (56 - 7 * (i + 1))) & 0x7f) << 1) for i in range(8))


def mschapv2_response(username, password, auth_challenge, peer_challenge):
    """RFC 2759：回傳 24 bytes 的 NT-Response。"""
    challenge = hashlib.sha1(peer_challenge + auth_challenge + username.encode()).digest()[:8]
    pw_hash = _md4(password.encode('utf-16-le')) + b'\x00' * 5
    return b''.join(_des_encrypt(_des_key(pw_hash[i:i + 7]), challenge) for i in (0, 7, 14))


def proxy_conf_text(proxy):
    """proxy.conf is owned by radius-manager. Without an external server the realm does not exist at all,
    so nothing can be proxied by accident; the stock example.com realm is dropped as well."""
    lines = ['# Managed by radius-manager. Change it in the web interface: Proxy.', '',
             'proxy server {', '\tdefault_fallback = no', '}', '', 'realm LOCAL {', '}', '']
    if proxy:
        family = 'ipv6addr' if ':' in proxy['server'] else 'ipaddr'
        lines += [f'home_server {PROXY_REALM} {{', '\ttype = auth', f"\t{family} = {proxy['server']}", f"\tport = {proxy['port']}",
                  f"\tsecret = '{proxy['secret']}'", '\tresponse_window = 10', '\tzombie_period = 20', '\trevive_interval = 30',
                  '\tstatus_check = none', '}', '',
                  f'home_server_pool {PROXY_REALM} {{', '\ttype = fail-over', f'\thome_server = {PROXY_REALM}', '}', '',
                  f'realm {PROXY_REALM} {{', f'\tauth_pool = {PROXY_REALM}', '\tnostrip', '}', '']
    return '\n'.join(lines).encode()


def proxy_params(params, state):
    server = text_param(params, 'server', maximum=253)
    try:
        server = str(ipaddress.ip_address(server))
    except ValueError:
        if not HOST_RE.fullmatch(server) or '..' in server:
            raise Refused('外部 RADIUS 位址格式錯誤')
    port = params.get('port')
    if not isinstance(port, int) or not 1 <= port <= 65535:
        raise Refused('連接埠必須是 1 到 65535')
    secret = params.get('secret') or ''
    if not secret:
        old = state.get('proxy')
        if not old:
            raise Refused('請輸入共用金鑰')
        secret = old['secret']
    if not isinstance(secret, str) or not PROXY_SECRET_RE.fullmatch(secret) or "'" in secret or '\\' in secret:
        raise Refused("共用金鑰必須是 6 到 128 個英數或符號，不可含空白、' 或 \\")
    return {'server': server, 'port': port, 'secret': secret}


def radius_attr(kind, value):
    return bytes((kind, len(value) + 2)) + value


def ms_attr(kind, value):
    sub = bytes((kind, len(value) + 2)) + value
    return radius_attr(26, struct.pack('>I', 311) + sub)


def proxy_probe(proxy, username, password, timeout=6):
    """Sends the same kind of request FreeRADIUS proxies (plain MS-CHAPv2) and reports what came back."""
    secret = proxy['secret'].encode()
    auth_challenge, peer_challenge, authenticator = os.urandom(16), os.urandom(16), os.urandom(16)
    ident = secrets.randbelow(256)
    nt_response = mschapv2_response(username, password, auth_challenge, peer_challenge)
    attrs = (radius_attr(1, username.encode()) + radius_attr(32, b'radius-manager-test') +
             ms_attr(11, auth_challenge) + ms_attr(25, bytes((ident, 0)) + peer_challenge + bytes(8) + nt_response) +
             radius_attr(80, bytes(16)))
    packet_id = secrets.randbelow(256)
    packet = bytearray(struct.pack('>BBH', 1, packet_id, 20 + len(attrs)) + authenticator + attrs)
    packet[-16:] = hmac.new(secret, bytes(packet), 'md5').digest()
    try:
        addr = socket.getaddrinfo(proxy['server'], proxy['port'], type=socket.SOCK_DGRAM)[0]
    except OSError:
        return 'dns', ''
    with socket.socket(addr[0], socket.SOCK_DGRAM) as sock:
        sock.settimeout(timeout)
        deadline = time.time() + timeout
        for _ in range(3):
            sock.sendto(bytes(packet), addr[4])
            try:
                while True:
                    sock.settimeout(max(0.1, min(2, deadline - time.time())))
                    reply, _ = sock.recvfrom(4096)
                    if len(reply) >= 20 and reply[1] == packet_id:
                        break
                break
            except socket.timeout:
                if time.time() >= deadline:
                    return 'timeout', ''
        else:
            return 'timeout', ''
    code, _, length = struct.unpack('>BBH', reply[:4])
    expected = hashlib.md5(reply[:4] + authenticator + reply[20:length] + secret).digest()
    if not hmac.compare_digest(expected, reply[4:20]):
        return 'badsecret', ''
    messages, pos = [], 20
    while pos + 2 <= length:
        kind, size = reply[pos], reply[pos + 1]
        if size < 2:
            break
        value = reply[pos + 2:pos + size]
        if kind == 18:
            messages.append(value.decode('utf-8', 'replace'))
        elif kind == 26 and len(value) > 6 and value[:4] == struct.pack('>I', 311) and value[4] == 2:
            messages.append('MS-CHAP-Error ' + value[7:].decode('ascii', 'replace'))
        pos += size
    detail = '；'.join(m.strip() for m in messages if m.strip())[:300]
    return {2: 'accept', 3: 'reject', 11: 'challenge'}.get(code, f'code{code}'), detail


def pap_probe(proxy, username, password):
    import importlib.machinery
    client = importlib.machinery.SourceFileLoader('radius_proxy_pap', '/usr/local/sbin/radius-proxy-pap').load_module()
    return client.pap_request(proxy['server'], proxy['port'], proxy['secret'], username, password)


def proxy_test_steps(steps, proxy, username, password, method='MSCHAPv2'):
    if not username:
        username, password = f'radius-manager-test-{secrets.token_hex(4)}', secrets.token_hex(12)
        tested = '測試用的隨機帳號'
    else:
        tested = f'測試帳號 {username} '
    pap = method != 'MSCHAPv2'
    result, detail = pap_probe(proxy, username, password) if pap else proxy_probe(proxy, username, password)
    kind = 'PAP' if pap else 'MS-CHAPv2'
    tested = f'{tested}（{kind}）'
    where = f"{proxy['server']}:{proxy['port']}"
    if result == 'dns':
        return steps.add(f'解析 {where}', False, '無法解析外部 RADIUS 的主機名稱')
    if result == 'timeout':
        return steps.add(f'連線 {where}', False, '沒有回應。請確認位址與連接埠、防火牆，外部 RADIUS 已把本機 IP 加入用戶端，以及共用金鑰正確'
                                                     '（多數伺服器收到錯誤金鑰的封包時不會回應）')
    if result == 'badsecret':
        return steps.add(f'連線 {where}', False, '有回應，但回應的驗證碼不符，共用金鑰錯誤')
    steps.add(f'連線 {where}', True, ok_detail='有回應，共用金鑰正確')
    extra = f'（{detail}）' if detail else ''
    if result == 'accept':
        return steps.add(f'以{tested}驗證', True, ok_detail='外部 RADIUS 接受' + extra)
    if result == 'reject':
        if tested.startswith('測試用'):
            return steps.add(f'以{tested}驗證', True, ok_detail='外部 RADIUS 回應拒絕，這是預期結果' + extra)
        if pap:
            return steps.add(f'以{tested}驗證', False, '外部 RADIUS 拒絕：帳號或密碼錯誤，或外部不接受 PAP 驗證' + extra)
        return steps.add(f'以{tested}驗證', False, '外部 RADIUS 拒絕：帳號或密碼錯誤，或外部不支援 MS-CHAPv2（例如帳號存在 LDAP 或 Google，'
                                                  '只能驗明文密碼）。可把內層改成 PAP 或 GTC 再測一次' + extra)
    return steps.add(f'以{tested}驗證', False, f'外部 RADIUS 回應了無法處理的封包（{result}）{extra}')


PROXY_METHODS = {'MSCHAPv2', 'PAP', 'GTC'}


def proxy_method(params):
    method = params.get('inner', 'MSCHAPv2')
    if method not in PROXY_METHODS:
        raise Refused('內層驗證方式錯誤')
    return method


def proxy_json(proxy):
    return json.dumps(proxy or {}, indent=1).encode()


def proxy_test_account(params):
    username = text_param(params, 'test_user', re.compile(r'[^\s"\\]{1,128}'), required=False)
    password = password_param(params, 'test_password', required=bool(username))
    return username, password


def action_proxy_configure(params):
    state = load_state()
    proxy = proxy_params(params, state)
    username, password = proxy_test_account(params)
    method = proxy_method(params)
    steps = Steps()
    if not proxy_test_steps(steps, proxy, username, password, method) and not params.get('force'):
        return {'ok': False, 'steps': steps.items}
    conf = proxy_conf_text(proxy)
    if read_bytes(PROXY_CONF) == conf and read_bytes(PROXY_JSON) == proxy_json(proxy):
        # Only the method changed: that lives in the web service's proxy-filter.json and needs no restart.
        steps.add('套用到 FreeRADIUS', True, ok_detail='外部 RADIUS 設定沒有變更，不需重新啟動 FreeRADIUS')
    else:
        tx = Transaction()
        tx.write(PROXY_CONF, conf)
        tx.write(PROXY_JSON, proxy_json(proxy))
        try:
            commit_freeradius(tx)
        except Refused as e:
            steps.add('套用到 FreeRADIUS', False, e)
            return {'ok': False, 'steps': steps.items}
        steps.add('套用到 FreeRADIUS', True, ok_detail='FreeRADIUS 已重新啟動')
    state['proxy'] = proxy
    save_state(state)
    return {'ok': True, 'steps': steps.items, 'server': proxy['server'], 'port': proxy['port']}


def action_proxy_test(params):
    proxy = load_state().get('proxy')
    if not proxy:
        raise Refused('尚未設定外部 RADIUS')
    username, password = proxy_test_account(params)
    steps = Steps()
    ok = proxy_test_steps(steps, proxy, username, password, proxy_method(params))
    return {'ok': ok, 'steps': steps.items}


def action_proxy_disable(params):
    state = load_state()
    tx = Transaction()
    tx.write(PROXY_CONF, proxy_conf_text(None))
    tx.write(PROXY_JSON, proxy_json(None))
    commit_freeradius(tx)
    state.pop('proxy', None)
    save_state(state)
    return {'ok': True, 'message': '外部 RADIUS 已停用，共用金鑰已刪除；Proxy SSID 的登入會全部被拒絕'}


# ---------------------------------------------------------------- version update
def version_key(version):
    return tuple(int(part) for part in version.split('.'))


def installed_version():
    return (read_bytes(os.path.join(APP_ROOT, 'VERSION')) or b'').decode().strip()


def project_info():
    try:
        with open(os.path.join(APP_ROOT, 'project.json'), encoding='utf-8') as f:
            info = json.load(f)
        if not re.fullmatch(r'[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+', info['repo']):
            raise ValueError('bad repo')
        return info
    except (OSError, ValueError, KeyError) as e:
        raise Refused(f'找不到專案資訊（project.json）：{e}')


def git_env(ssh):
    env = {'GIT_TERMINAL_PROMPT': '0', 'GIT_CONFIG_NOSYSTEM': '1', 'HOME': ROOT_DIR, 'GIT_ASKPASS': '/bin/false'}
    if ssh:
        if not os.path.exists(UPDATE_KNOWN_HOSTS):
            write_file(UPDATE_KNOWN_HOSTS, (GITHUB_HOST_KEY + '\n').encode(), 0o600, 'root', 'root')
        env['GIT_SSH_COMMAND'] = (f'ssh -i {UPDATE_KEY} -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=yes '
                                  f'-o UserKnownHostsFile={UPDATE_KNOWN_HOSTS} -o ConnectTimeout=15')
    return env


def update_sources():
    """(url, env, label)。公開的 repo 走 HTTPS；private 要用這台主機的讀取金鑰（deploy key）走 SSH。"""
    override = (read_bytes(UPDATE_SOURCE_OVERRIDE) or b'').decode().strip()
    if override:
        return [(override, git_env(False), 'override')]
    repo = project_info()['repo']
    sources = [(f'https://github.com/{repo}.git', git_env(False), 'https')]
    if os.path.exists(UPDATE_KEY):
        sources.append((f'git@github.com:{repo}.git', git_env(True), 'ssh'))
    return sources


def remote_versions():
    """回傳 (url, env, label, 版本清單由新到舊)。只認 vX.Y.Z 標籤。"""
    errors = []
    for url, env, label in update_sources():
        result = run(['git', 'ls-remote', '--tags', '--refs', url], timeout=30, env=env)
        if result.returncode == 0:
            versions = {m.group(1) for m in re.finditer(r'refs/tags/v([0-9]{1,4}\.[0-9]{1,4}\.[0-9]{1,4})$', result.stdout, re.M)}
            return url, env, label, sorted(versions, key=version_key, reverse=True)
        errors.append(f'{label}: {output_tail(result, 200)}')
    hint = '' if os.path.exists(UPDATE_KEY) else '如果 GitHub 專案是 private，請按「產生讀取金鑰」並把公鑰加到專案的 Deploy keys。'
    raise Refused(f'無法連到 GitHub 取得版本。{hint}（{" / ".join(errors)}）')


def fetch_version(url, env, version, dest):
    """淺層 clone 指定版本的標籤到 dest，並確認內容是這個版本。"""
    if os.path.exists(dest):
        shutil.rmtree(dest)
    result = run(['git', '-c', 'advice.detachedHead=false', 'clone', '-q', '--depth', '1', '--branch', f'v{version}', url, dest],
                 timeout=180, env=env)
    if result.returncode != 0:
        raise Refused(f'下載 v{version} 失敗：{output_tail(result)}')
    shutil.rmtree(os.path.join(dest, '.git'), ignore_errors=True)
    got = (read_bytes(os.path.join(dest, 'VERSION')) or b'').decode().strip()
    if got != version or not os.path.exists(os.path.join(dest, 'app/radius_manager.py')) or not os.path.exists(os.path.join(dest, 'install.sh')):
        raise Refused(f'v{version} 的內容不完整或版本號不符（VERSION={got!r}）')
    return dest


def changelog_sections(text):
    """CHANGELOG.md 的「## X.Y.Z ...」段落，回傳 {版本: (標題, 內容)}。"""
    sections, current = {}, None
    for line in text.splitlines():
        match = re.match(r'^##\s+v?([0-9]{1,4}\.[0-9]{1,4}\.[0-9]{1,4})\b(.*)$', line)
        if match:
            current = match.group(1)
            sections[current] = [line[2:].strip(), []]
        elif current and not line.startswith('# '):
            sections[current][1].append(line)
    return {v: (title, '\n'.join(body).strip()) for v, (title, body) in sections.items()}


def deploy_public_key():
    return (read_bytes(UPDATE_KEY + '.pub') or b'').decode().strip()


def action_update_check(params):
    current = installed_version()
    info = project_info()
    url, env, label, versions = remote_versions()
    latest = versions[0] if versions else ''
    newer = [v for v in versions if VERSION_RE.fullmatch(current or '') and version_key(v) > version_key(current)]
    notes = {}
    if latest:
        work = tempfile.mkdtemp(dir='/run', prefix='.radmgr-notes-')
        try:
            fetch_version(url, env, latest, os.path.join(work, 'src'))
            notes = changelog_sections((read_bytes(os.path.join(work, 'src', 'CHANGELOG.md')) or b'').decode('utf-8', 'replace'))
        except Refused as e:
            notes = {latest: ('', f'（無法讀取版本說明：{e}）')}
        finally:
            shutil.rmtree(work, ignore_errors=True)
    def note(v):
        title, body = notes.get(v, (f'{v}', ''))
        return {'version': v, 'title': title or v, 'notes': body or '（這個版本沒有版本說明）'}
    return {'ok': True, 'current': current, 'latest': latest, 'versions': versions[:30], 'via': label,
            'newer': [note(v) for v in newer], 'current_notes': note(current) if current in notes else None,
            'repo': info['repo'], 'public_key': deploy_public_key(), 'running': update_running()}


def action_update_key(params):
    if not os.path.exists(UPDATE_KEY):
        result = run(['ssh-keygen', '-q', '-t', 'ed25519', '-N', '', '-C', f'freeradius-woofweb update ({socket.gethostname()})',
                      '-f', UPDATE_KEY], timeout=30)
        if result.returncode != 0:
            raise Refused(f'無法產生金鑰：{output_tail(result)}')
    return {'ok': True, 'public_key': deploy_public_key()}


def file_digests(root):
    digests = {}
    for part in INSTALL_PARTS:
        base = os.path.join(root, part)
        if os.path.isfile(base):
            paths = [base]
        elif os.path.isdir(base):
            paths = [os.path.join(d, f) for d, dirs, files in os.walk(base) for f in files
                     if '__pycache__' not in d.split(os.sep) and not f.endswith('.pyc')]
        else:
            continue
        for path in paths:
            with open(path, 'rb') as f:
                digests[os.path.relpath(path, root)] = hashlib.sha256(f.read()).hexdigest()
    return digests


def action_update_verify(params):
    current = installed_version()
    url, env, label, versions = remote_versions()
    if current not in versions:
        raise Refused(f'GitHub 上沒有 v{current} 這個版本，無法校驗')
    local_root = os.path.realpath(APP_ROOT)
    work = tempfile.mkdtemp(dir='/run', prefix='.radmgr-verify-')
    try:
        remote = file_digests(fetch_version(url, env, current, os.path.join(work, 'src')))
    finally:
        shutil.rmtree(work, ignore_errors=True)
    local = file_digests(local_root)
    rows = []
    for path in sorted(set(remote) | set(local)):
        if path not in local:
            state = 'missing'
        elif path not in remote:
            state = 'extra'
        else:
            state = 'same' if local[path] == remote[path] else 'modified'
        if state != 'same':
            rows.append({'path': path, 'state': state})
    # The commands FreeRADIUS runs must point into this release.
    links = []
    for name in ('radius-manager', 'radius-ssid-policy', 'radius-device-limit', 'radius-group-policy', 'radius-proxy-filter', 'radius-proxy-pap'):
        target = os.path.realpath(f'/usr/local/sbin/{name}')
        if target != os.path.join(local_root, 'bin', name):
            links.append({'path': f'/usr/local/sbin/{name}', 'state': f'指向 {target}'})
    return {'ok': True, 'version': current, 'via': label, 'compared': len(set(remote) | set(local)),
            'same': sum(1 for p in remote if local.get(p) == remote[p]), 'differences': rows[:300], 'links': links,
            'release': local_root}


def update_running():
    return run(['systemctl', 'is-active', '--quiet', UPDATE_UNIT]).returncode == 0


def write_status(status):
    write_file(UPDATE_STATUS, json.dumps({**status, 'updated': time.strftime('%Y-%m-%d %H:%M:%S')}, ensure_ascii=False).encode(),
               0o640, 'root', SERVICE_USER)


def list_backups():
    items = []
    if os.path.isdir(UPDATE_BACKUPS):
        for name in sorted(os.listdir(UPDATE_BACKUPS), reverse=True):
            path = os.path.join(UPDATE_BACKUPS, name)
            if not BACKUP_ID_RE.fullmatch(name) or not os.path.exists(os.path.join(path, 'code.tar.gz')):
                continue
            try:
                with open(os.path.join(path, 'info.json'), encoding='utf-8') as f:
                    info = json.load(f)
            except (OSError, ValueError):
                info = {}
            items.append({'id': name, 'time': info.get('time', ''), 'version': info.get('version', '?'), 'reason': info.get('reason', ''),
                          'size': sum(os.path.getsize(os.path.join(path, f)) for f in os.listdir(path))})
    return items


def action_update_backups(params):
    return {'ok': True, 'backups': list_backups(), 'running': update_running()}


def action_update_start(params):
    if update_running():
        raise Refused('已有更新或回溯正在進行')
    kind = params.get('kind')
    if kind == 'update':
        version = params.get('version', '')
        if not isinstance(version, str) or not VERSION_RE.fullmatch(version):
            raise Refused('版本格式錯誤')
        current = installed_version()
        versions = remote_versions()[3]
        if version not in versions:
            raise Refused(f'GitHub 上沒有 v{version}')
        if VERSION_RE.fullmatch(current) and version_key(version) <= version_key(current):
            raise Refused('只能更新到比目前新的版本；要回到舊版請用下方的回溯')
        arg = version
    elif kind == 'rollback':
        arg = params.get('backup', '')
        if not isinstance(arg, str) or not BACKUP_ID_RE.fullmatch(arg) or not os.path.exists(os.path.join(UPDATE_BACKUPS, arg, 'code.tar.gz')):
            raise Refused('找不到這個備份')
    else:
        raise Refused('不支援的操作')
    write_status({'state': 'running', 'kind': kind, 'target': arg, 'from': installed_version(), 'steps': [], 'log': ''})
    helper = os.path.realpath(os.path.join(APP_ROOT, 'bin', 'radius-manager-helper'))
    result = run(['systemd-run', f'--unit={UPDATE_UNIT}', '--collect', '--quiet', '--description=freeradius-woofweb update',
                  helper, 'update-run', kind, arg], timeout=30)
    if result.returncode != 0:
        write_status({'state': 'failed', 'kind': kind, 'target': arg, 'steps': [], 'log': output_tail(result)})
        raise Refused(f'無法啟動：{output_tail(result)}')
    return {'ok': True}


def add_to_tar(tar, path, arcname):
    if os.path.lexists(path):
        tar.add(path, arcname=arcname, recursive=True)
        return [arcname]
    return []


CONFIG_FILES = (
    ('/etc/radius-manager', 'etc/radius-manager'),
    (f'{STATE_DIR}/settings.json', 'var/lib/radius-manager/settings.json'),
    (f'{STATE_DIR}/ap_list.json', 'var/lib/radius-manager/ap_list.json'),
    (f'{STATE_DIR}/metadata.json', 'var/lib/radius-manager/metadata.json'),
    (f'{STATE_DIR}/proxy.json', 'var/lib/radius-manager/proxy.json'),
    (f'{STATE_DIR}/logo', 'var/lib/radius-manager/logo'),
    (ROOT_STATE, 'var/lib/radius-manager-root/state.json'),
    (f'{RADDB}/authorized_macs', 'etc/freeradius/3.0/authorized_macs'),
    (CLIENTS, 'etc/freeradius/3.0/clients.conf'),
    (PROXY_CONF, 'etc/freeradius/3.0/proxy.conf'),
    (PROXY_JSON, 'etc/freeradius/3.0/radius-manager-proxy.json'),
    (LDAP_CONF, 'etc/freeradius/3.0/ldap-google.conf'),
    (LDAP_CERT, 'etc/freeradius/3.0/certs/ldap-client.crt'),
    (LDAP_KEY, 'etc/freeradius/3.0/certs/ldap-client.key'),
    (EAP_CERT_DIR, 'etc/freeradius/3.0/certs/radius-manager'),
    (f'{RADDB}/mods-available/mschap', 'etc/freeradius/3.0/mods-available/mschap'),
    (SMB_CONF, 'etc/samba/smb.conf'),
    (KRB5_CONF, 'etc/krb5.conf'),
)
MACAUTH_DIR = '/var/log/freeradius/macauth'
MACAUTH_SETTINGS = ('ssid-rules.json', 'device-limit.json', 'group-policy.json', 'blacklist.json', 'group-vlan.json', 'proxy-filter.json')


def build_config_archive(dest):
    """所有設定（含密碼雜湊、RADIUS 金鑰、憑證私鑰）。不含登入紀錄、快取、AD 機器帳號的 secrets.tdb。"""
    import tarfile
    included = []
    with tarfile.open(dest, 'w:gz') as tar:
        for path, arcname in CONFIG_FILES:
            included += add_to_tar(tar, path, arcname)
        for name in MACAUTH_SETTINGS:
            included += add_to_tar(tar, os.path.join(MACAUTH_DIR, name), f'var/log/freeradius/macauth/{name}')
        readme = (f'freeradius-woofweb settings export\nversion: {installed_version()}\nhost: {socket.gethostname()}\n'
                  f'time: {time.strftime("%Y-%m-%d %H:%M:%S")}\n\n'
                  'This archive contains secrets: the admin password hash, the web session key, RADIUS shared secrets,\n'
                  'Google LDAP credentials and private keys. Keep it offline and delete copies you do not need.\n\n'
                  'Not included: login history (logins.db), caches, and the AD machine account (re-join AD after restoring).\n'
                  'Restore on a fresh install of the same version: stop radius-manager and freeradius, extract with\n'
                  '"tar -xzpf <file> -C /", run "radius-manager-helper render", then start both services.\n\nFiles:\n'
                  + ''.join(f'  /{name}\n' for name in included)).encode()
        import io
        member = tarfile.TarInfo('README.txt')
        member.size, member.mtime, member.mode = len(readme), int(time.time()), 0o600
        tar.addfile(member, io.BytesIO(readme))
    os.chmod(dest, 0o600)
    return included


def action_config_export(params):
    os.makedirs(EXPORT_DIR, exist_ok=True)
    shutil.chown(EXPORT_DIR, SERVICE_USER, SERVICE_USER)
    os.chmod(EXPORT_DIR, 0o700)
    now = time.time()
    for old in os.listdir(EXPORT_DIR):
        if now - os.lstat(os.path.join(EXPORT_DIR, old)).st_mtime > 600:
            os.unlink(os.path.join(EXPORT_DIR, old))
    name = f"freeradius-woofweb-config-{re.sub(r'[^A-Za-z0-9-]', '', socket.gethostname())[:32]}-{installed_version()}-{time.strftime('%Y%m%d-%H%M%S')}.tar.gz"
    dest = os.path.join(EXPORT_DIR, name)
    included = build_config_archive(dest)
    shutil.chown(dest, SERVICE_USER, SERVICE_USER)
    return {'ok': True, 'file': name, 'count': len(included)}


def update_run(kind, arg):
    """在背景執行（systemd-run）。網頁服務會在安裝時重啟，進度寫在 update-status.json。"""
    status = {'state': 'running', 'kind': kind, 'target': arg, 'from': installed_version(), 'steps': [], 'log': ''}

    def step(name, ok=True, detail=''):
        status['steps'].append({'name': name, 'ok': ok, 'detail': str(detail)[:600]})
        write_status(status)
    os.makedirs(UPDATE_WORK, mode=0o700, exist_ok=True)
    work = tempfile.mkdtemp(dir=UPDATE_WORK)
    src = os.path.join(work, 'src')
    try:
        if kind == 'update':
            url, env, label, versions = remote_versions()
            if arg not in versions:
                raise Refused(f'GitHub 上沒有 v{arg}')
            fetch_version(url, env, arg, src)
            step(f'下載 v{arg}', detail=f'來源 {label}')
            target = arg
        else:
            backup = os.path.join(UPDATE_BACKUPS, arg)
            os.makedirs(src)
            result = run(['tar', '-xzf', os.path.join(backup, 'code.tar.gz'), '-C', src], timeout=120)
            if result.returncode != 0:
                raise Refused(f'備份檔無法解開：{output_tail(result)}')
            if not os.path.exists(os.path.join(src, 'install.sh')):
                # Releases before 0.8.0 did not keep install.sh; this version's installer handles them.
                shutil.copy2(os.path.join(os.path.realpath(APP_ROOT), 'install.sh'), os.path.join(src, 'install.sh'))
            target = (read_bytes(os.path.join(src, 'VERSION')) or b'').decode().strip()
            step(f'讀取備份 {arg}', detail=f'版本 {target}')
        # Back up the running code and every setting before touching anything.
        current = installed_version()
        backup_id = f"{time.strftime('%Y%m%d-%H%M%S')}-{current or 'unknown'}"
        backup_dir = os.path.join(UPDATE_BACKUPS, backup_id)
        os.makedirs(backup_dir, mode=0o700)
        result = run(['tar', '-czf', os.path.join(backup_dir, 'code.tar.gz'), '--exclude=__pycache__', '-C', os.path.realpath(APP_ROOT), '.'], timeout=300)
        if result.returncode != 0:
            raise Refused(f'備份程式失敗，未更新：{output_tail(result)}')
        build_config_archive(os.path.join(backup_dir, 'config.tar.gz'))
        write_file(os.path.join(backup_dir, 'info.json'), json.dumps({
            'time': time.strftime('%Y-%m-%d %H:%M:%S'), 'version': current,
            'reason': f'更新到 {target} 之前' if kind == 'update' else f'回溯到 {target} 之前'}, ensure_ascii=False).encode(), 0o600, 'root', 'root')
        step('備份目前的程式與設定', detail=f'備份 {backup_id}')
        for old in list_backups()[KEEP_BACKUPS:]:
            shutil.rmtree(os.path.join(UPDATE_BACKUPS, old['id']), ignore_errors=True)
        result = run(['bash', os.path.join(src, 'install.sh'), '--source', src], timeout=1200)
        status['log'] = ((result.stdout or '') + (result.stderr or ''))[-4000:]
        if result.returncode != 0:
            raise Refused('安裝失敗，安裝程式已切回原本的版本（詳見下方紀錄）')
        step(f'安裝 {target}', detail='FreeRADIUS 與網頁服務已重新啟動')
        status['state'] = 'done'
        status['result_version'] = installed_version()
        write_status(status)
    except Refused as e:
        step('失敗', ok=False, detail=e)
        status['state'] = 'failed'
        write_status(status)
    except Exception as e:
        step('失敗', ok=False, detail=f'{type(e).__name__}: {e}')
        status['state'] = 'failed'
        write_status(status)
    finally:
        shutil.rmtree(work, ignore_errors=True)


# ---- 認證效能測試 ----
# 複製一份 FreeRADIUS 設定到 /run，綁 127.0.0.1 的另一個 port，用本機測試帳號與測試 MAC 跑。
# 登入紀錄、裝置上限資料庫都寫到測試目錄（${logdir} 改到測試目錄），結束就刪除；不碰正式的 1812、名單與紀錄。
# AD（ntlm_auth 與網域控制站）、Google LDAP、外部 Proxy 不在測試範圍：測試帳號用本機密碼。
BENCH_STATUS = f'{STATE_DIR}/bench-status.json'
BENCH_DIR = '/run/radius-manager-bench'
BENCH_UNIT = 'radius-manager-bench'
BENCH_ACCOUNT = 'woofbench'
BENCH_MAC = '02-57-4F-4F-46-01'
BENCH_AP = '02-57-4F-4F-46-AA'
BENCH_SSID_MAC = 'WoofBench-Device'
BENCH_SSID_PEAP = 'WoofBench-Staff'
EAPOL_TEST = '/usr/bin/eapol_test'


def bench_write(status):
    write_file(BENCH_STATUS, json.dumps({**status, 'updated': time.strftime('%Y-%m-%d %H:%M:%S')}, ensure_ascii=False).encode(),
               0o640, 'root', SERVICE_USER)


def bench_running():
    return run(['systemctl', 'is-active', '--quiet', BENCH_UNIT]).returncode == 0


def action_bench_start(params):
    if bench_running():
        raise Refused('已有測試正在進行')
    if update_running():
        raise Refused('版本更新進行中，請稍後再測試')
    bench_write({'state': 'running', 'phase': '準備中', 'phases': [], 'started': time.strftime('%Y-%m-%d %H:%M:%S')})
    helper = os.path.realpath(os.path.join(APP_ROOT, 'bin', 'radius-manager-helper'))
    result = run(['systemd-run', f'--unit={BENCH_UNIT}', '--collect', '--quiet', '--description=freeradius-woofweb benchmark',
                  '-p', 'RuntimeMaxSec=300', helper, 'bench-run'], timeout=30)
    if result.returncode != 0:
        bench_write({'state': 'failed', 'phases': [], 'error': f'無法啟動：{output_tail(result)}'})
        raise Refused(f'無法啟動：{output_tail(result)}')
    return {'ok': True}


def cpu_info():
    model = ''
    try:
        for line in open('/proc/cpuinfo', encoding='utf-8', errors='replace'):
            if line.startswith('model name'):
                model = line.split(':', 1)[1].strip()
                break
    except OSError:
        pass
    mem = 0
    try:
        for line in open('/proc/meminfo', encoding='utf-8'):
            if line.startswith('MemTotal:'):
                mem = int(line.split()[1]) // 1024
    except OSError:
        pass
    # LXC 可能限制可用的 CPU：以這個程序能用的 CPU 為準
    return {'cpus': len(os.sched_getaffinity(0)), 'model': model, 'mem_mb': mem}


def proc_cpu_seconds(pid):
    """FreeRADIUS 本身加上已結束的子程序（SSID 規則、裝置上限等每次登入執行的程式）。"""
    with open(f'/proc/{pid}/stat', encoding='utf-8') as f:
        fields = f.read().rsplit(')', 1)[1].split()
    return sum(int(v) for v in fields[11:15]) / os.sysconf('SC_CLK_TCK')


def host_cpu():
    with open('/proc/stat', encoding='utf-8') as f:
        values = [int(v) for v in f.readline().split()[1:]]
    idle = values[3] + (values[4] if len(values) > 4 else 0)
    return sum(values) - idle, sum(values)


def proc_rss_mb(pid):
    try:
        for line in open(f'/proc/{pid}/status', encoding='utf-8'):
            if line.startswith('VmRSS:'):
                return int(line.split()[1]) // 1024
    except OSError:
        pass
    return 0


def pap_encrypt(secret, authenticator, password):
    data = password.ljust(max(16, (len(password) + 15) // 16 * 16), b'\x00')
    out, last = b'', authenticator
    for i in range(0, len(data), 16):
        key = hashlib.md5(secret + last).digest()
        last = bytes(a ^ b for a, b in zip(data[i:i + 16], key))
        out += last
    return out


def bench_mac_once(sock, secret, port):
    """名單（MAC）認證一次，跟 AP 送的一樣（含 Message-Authenticator）。回傳 accept、reject 或 timeout。"""
    user = BENCH_MAC.replace('-', '').lower().encode()
    ident, authenticator = secrets.randbelow(256), secrets.token_bytes(16)
    attrs = [(1, user), (2, pap_encrypt(secret, authenticator, user)), (4, socket.inet_aton('127.0.0.1')), (61, struct.pack('!I', 19)),
             (30, f'{BENCH_AP}:{BENCH_SSID_MAC}'.encode()), (31, BENCH_MAC.encode())]
    body = b''.join(struct.pack('BB', t, len(v) + 2) + v for t, v in attrs) + struct.pack('BB', 80, 18) + b'\x00' * 16
    packet = struct.pack('!BBH', 1, ident, 20 + len(body)) + authenticator + body
    packet = packet[:-16] + hmac.new(secret, packet, hashlib.md5).digest()
    sock.sendto(packet, ('127.0.0.1', port))
    deadline = time.monotonic() + 5
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return 'timeout'
        sock.settimeout(remaining)
        try:
            reply = sock.recv(4096)
        except socket.timeout:
            return 'timeout'
        if len(reply) >= 20 and reply[1] == ident:
            return 'accept' if reply[0] == 2 else 'reject'


def bench_peap_once(conf, secret, port):
    result = run([EAPOL_TEST, '-c', conf, '-a', '127.0.0.1', '-p', str(port), '-s', secret.decode(), '-M', BENCH_MAC.replace('-', ':'),
                  '-N', f'30:s:{BENCH_AP}:{BENCH_SSID_PEAP}', '-t', '15', '-r', '0'], timeout=20)
    if result.returncode == 0 and 'SUCCESS' in result.stdout:
        return 'accept'
    return 'timeout' if result.returncode == 124 or 'EAPOL test timed out' in result.stdout else 'reject'


def bench_phase(name, kind, workers, seconds, pid, once):
    import threading
    latencies, outcomes = [], {'accept': 0, 'reject': 0, 'timeout': 0}
    lock = threading.Lock()
    stop_at = time.monotonic() + seconds

    def worker():
        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM) if kind == 'mac' else None
        try:
            while time.monotonic() < stop_at:
                start = time.monotonic()
                outcome = once(sock)
                took = time.monotonic() - start
                with lock:
                    outcomes[outcome] += 1
                    if outcome == 'accept':
                        latencies.append(took)
        finally:
            if sock:
                sock.close()
    cpu0, host0, wall0 = proc_cpu_seconds(pid), host_cpu(), time.monotonic()
    threads = [threading.Thread(target=worker, daemon=True) for _ in range(workers)]
    for t in threads:
        t.start()
    for t in threads:
        t.join(timeout=seconds + 40)
    wall = time.monotonic() - wall0
    cpu1, host1 = proc_cpu_seconds(pid), host_cpu()
    server_cpu = cpu1 - cpu0
    total = sum(outcomes.values())
    busy = (host1[0] - host0[0]) / max(1, host1[1] - host0[1])
    latencies.sort()

    def pct(p):
        return round(latencies[min(len(latencies) - 1, int(len(latencies) * p))] * 1000) if latencies else None
    info = cpu_info()
    per_login = server_cpu / outcomes['accept'] if outcomes['accept'] else None
    return {'name': name, 'kind': kind, 'workers': workers, 'seconds': round(wall, 1), **outcomes, 'total': total,
            'rate': round(outcomes['accept'] / wall, 1) if wall else 0,
            'p50_ms': pct(0.5), 'p95_ms': pct(0.95), 'max_ms': round(latencies[-1] * 1000) if latencies else None,
            'server_cpu_pct': round(server_cpu / wall * 100) if wall else 0,
            'host_cpu_pct': round(busy * info['cpus'] * 100),
            'cpu_ms_per_login': round(per_login * 1000, 1) if per_login else None,
            # 只算 FreeRADIUS 自己用的 CPU，假設測試程式不在這台、全部 CPU 都給 FreeRADIUS 時的上限
            'estimate': round(info['cpus'] / per_login, 1) if per_login else None}


def free_udp_port():
    for port in range(18190, 18290):
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        try:
            s.bind(('127.0.0.1', port))
            return port
        except OSError:
            continue
        finally:
            s.close()
    raise Refused('找不到可用的測試 port')


def bench_prepare(secret):
    """回傳 (raddb 副本, eapol_test 設定檔)。"""
    shutil.rmtree(BENCH_DIR, ignore_errors=True)
    os.makedirs(BENCH_DIR, mode=0o750)
    shutil.chown(BENCH_DIR, 'root', 'freerad')
    raddb = os.path.join(BENCH_DIR, 'raddb')
    shutil.copytree(RADDB, raddb, symlinks=True)
    # copytree 不保留擁有者：FreeRADIUS 以 freerad 讀設定，照原檔設定擁有者
    for root, dirs, files in os.walk(RADDB):
        for name in [''] + dirs + files:
            src = os.path.join(root, name)
            st = os.lstat(src)
            os.lchown(os.path.join(raddb, os.path.relpath(src, RADDB)), st.st_uid, st.st_gid)
    for d in ('log', 'log/macauth', 'log/radacct', 'run'):
        os.makedirs(os.path.join(BENCH_DIR, d), mode=0o770, exist_ok=True)
        shutil.chown(os.path.join(BENCH_DIR, d), 'freerad', 'freerad')
    conf = read_bytes(f'{raddb}/radiusd.conf').decode()
    for name, value in (('raddbdir', raddb), ('logdir', f'{BENCH_DIR}/log'), ('run_dir', f'{BENCH_DIR}/run')):
        conf, count = re.subn(rf'^{name}\s*=.*$', f'{name} = {value}', conf, count=1, flags=re.M)
        if not count:
            raise Refused(f'radiusd.conf 沒有 {name}，無法建立測試環境')
    write_file(f'{raddb}/radiusd.conf', conf.encode(), 0o640)
    write_file(f'{raddb}/clients.conf', f'client woofbench {{\n\tipaddr = 127.0.0.1\n\tsecret = {secret.decode()}\n}}\n'.encode(), 0o640)
    password = secrets.token_hex(12)
    users = read_bytes(f'{raddb}/mods-config/files/authorize') or b''
    write_file(f'{raddb}/mods-config/files/authorize',
               f'{BENCH_ACCOUNT} Cleartext-Password := "{password}", MS-CHAP-Use-NTLM-Auth := No\n\n'.encode() + users, 0o640)
    macs = read_bytes(f'{raddb}/authorized_macs') or b''
    write_file(f'{raddb}/authorized_macs', macs + (f'\n#{BENCH_ACCOUNT}\n{BENCH_MAC}\n        Tunnel-Type = 13,\n'
                                                     '        Tunnel-Medium-Type = 6,\n        Tunnel-Private-Group-ID = 1\n\n').encode(), 0o640)
    macauth = os.path.join(BENCH_DIR, 'log', 'macauth')
    rules = {'rules': [{'keyword': BENCH_SSID_MAC, 'auth': 'mac', 'vlan': ''}, {'keyword': BENCH_SSID_PEAP, 'auth': 'ad', 'vlan': ''}],
             'default': {'auth': 'ad', 'vlan': ''}}
    # 上限 0（不限制）仍會寫入裝置資料庫，成本與正式環境相同
    for name, data in (('ssid-rules.json', rules), ('device-limit.json', {'limit': 0, 'proxy_limit': 0, 'exempt': [], 'window_hours': 24}),
                       ('blacklist.json', {'ad': [], 'google': []})):
        write_file(os.path.join(macauth, name), json.dumps(data).encode(), 0o644, 'freerad', 'freerad')
    eapol = os.path.join(BENCH_DIR, 'peap.conf')
    write_file(eapol, ('network={\n\tkey_mgmt=WPA-EAP\n\teap=PEAP\n\tidentity="%s"\n\tanonymous_identity="anonymous"\n'
                       '\tpassword="%s"\n\tphase2="auth=MSCHAPV2"\n}\n' % (BENCH_ACCOUNT, password)).encode(), 0o600, 'root', 'root')
    return raddb, eapol


def bench_run():
    """在背景執行（systemd-run，最多 5 分鐘）。結果寫在 bench-status.json，網頁輪詢。"""
    info = cpu_info()
    status = {'state': 'running', 'phase': '建立測試環境', 'phases': [], 'host': info, 'started': time.strftime('%Y-%m-%d %H:%M:%S'),
              'version': installed_version()}
    bench_write(status)
    server = None
    try:
        secret = secrets.token_hex(16).encode()
        raddb, eapol = bench_prepare(secret)
        port = free_udp_port()
        log = open(os.path.join(BENCH_DIR, 'freeradius.out'), 'wb')
        server = subprocess.Popen(['/usr/sbin/freeradius', '-f', '-d', raddb, '-n', 'radiusd', '-i', '127.0.0.1', '-p', str(port), '-lstdout'],
                                  stdout=log, stderr=subprocess.STDOUT, env={**os.environ, 'LC_ALL': 'C.UTF-8'})
        # 等測試實例可以回應（讀設定、載入憑證）
        probe = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        ready = False
        deadline = time.monotonic() + 30
        while time.monotonic() < deadline and server.poll() is None:
            if bench_mac_once(probe, secret, port) == 'accept':
                ready = True
                break
            time.sleep(0.5)
        probe.close()
        if not ready:
            tail = (read_bytes(os.path.join(BENCH_DIR, 'freeradius.out')) or b'').decode('utf-8', 'replace').strip().splitlines()[-8:]
            raise Refused('測試用的 FreeRADIUS 沒有正常啟動：' + ' / '.join(tail)[-600:])
        status['port'] = port
        many = min(32, max(8, info['cpus'] * 4))
        plan = [('名單（MAC）認證・單一連線', 'mac', 1, 5), (f'名單（MAC）認證・{many * 2} 個同時', 'mac', many * 2, 10)]
        if os.path.exists(EAPOL_TEST):
            plan += [('PEAP-MSCHAPv2・單一連線', 'peap', 1, 8), (f'PEAP-MSCHAPv2・{many} 個同時', 'peap', many, 15)]
        else:
            status['note'] = '這台主機沒有 eapol_test（eapoltest 套件），只測名單認證。重新執行安裝程式會安裝。'
        for name, kind, workers, seconds in plan:
            status['phase'] = name
            bench_write(status)
            once = (lambda sock: bench_mac_once(sock, secret, port)) if kind == 'mac' else (lambda sock: bench_peap_once(eapol, secret, port))
            status['phases'].append(bench_phase(name, kind, workers, seconds, server.pid, once))
            bench_write(status)
        status['rss_mb'] = proc_rss_mb(server.pid)
        status['state'] = 'done'
    except Refused as e:
        status.update(state='failed', error=str(e))
    except Exception as e:
        status.update(state='failed', error=f'{type(e).__name__}: {e}')
    finally:
        if server and server.poll() is None:
            server.terminate()
            try:
                server.wait(timeout=10)
            except subprocess.TimeoutExpired:
                server.kill()
        shutil.rmtree(BENCH_DIR, ignore_errors=True)
        status['phase'] = ''
        status['finished'] = time.strftime('%Y-%m-%d %H:%M:%S')
        bench_write(status)


ACTIONS = {
    'radius_clients': action_radius_clients, 'timezone': action_timezone,
    'ad_join': action_ad_join, 'ad_test': action_ad_test, 'ad_disable': action_ad_disable,
    'google_configure': action_google_configure, 'google_test': action_google_test, 'google_disable': action_google_disable,
    'eap_cert': action_eap_cert, 'eap_cert_initial': action_eap_cert_initial, 'eap_cert_info': action_eap_cert_info,
    'ldap_cert_info': action_ldap_cert_info, 'web_cert': action_web_cert,
    'proxy_configure': action_proxy_configure, 'proxy_test': action_proxy_test, 'proxy_disable': action_proxy_disable,
    'update_check': action_update_check, 'update_key': action_update_key, 'update_verify': action_update_verify,
    'update_backups': action_update_backups, 'update_start': action_update_start, 'config_export': action_config_export,
    'bench_start': action_bench_start,
}


def write_result(request_id, result):
    write_file(os.path.join(RESULT_DIR, f'{request_id}.json'), json.dumps(result, ensure_ascii=False).encode(), 0o640, 'root', SERVICE_USER)


def handle(path, name):
    request_id = name[:-5]
    uid = pwd.getpwnam(SERVICE_USER).pw_uid
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != uid or st.st_size > MAX_REQUEST:
            write_result(request_id, {'ok': False, 'error': '請求不合法'})
            return
        with os.fdopen(os.dup(fd), encoding='utf-8') as f:
            data = json.load(f)
    finally:
        os.close(fd)
        # Requests can hold passwords: gone before anything else happens.
        os.unlink(path)
    action = ACTIONS.get(data.get('action'))
    if action is None or not isinstance(data.get('params'), dict):
        write_result(request_id, {'ok': False, 'error': '不支援的操作'})
        return
    try:
        result = action(data['params'])
        result.setdefault('ok', True)
    except Refused as e:
        result = {'ok': False, 'error': str(e)}
    except Exception as e:
        print(f'{data.get("action")} failed: {type(e).__name__}', file=sys.stderr)
        result = {'ok': False, 'error': f'內部錯誤（{type(e).__name__}），請查看 journalctl -u radius-manager-helper'}
    write_result(request_id, result)


def process():
    now = time.time()
    for name in os.listdir(RESULT_DIR):
        path = os.path.join(RESULT_DIR, name)
        if now - os.lstat(path).st_mtime > RESULT_MAX_AGE:
            os.unlink(path)
    for _ in range(100):
        names = sorted(n for n in os.listdir(REQUEST_DIR) if re.fullmatch(r'[0-9a-f]{32}\.json', n))
        if not names:
            return
        for name in names:
            try:
                handle(os.path.join(REQUEST_DIR, name), name)
            except (OSError, ValueError) as e:
                print(f'bad request {name}: {type(e).__name__}', file=sys.stderr)
                write_result(name[:-5], {'ok': False, 'error': '請求不合法'})
                path = os.path.join(REQUEST_DIR, name)
                if os.path.lexists(path):
                    os.unlink(path)


def ensure_setting(text, name, value):
    """Sets `name = value` on the first uncommented top-level or section line, otherwise adds it."""
    pattern = re.compile(rf'^([ \t]*){re.escape(name)}[ \t]*=.*$', re.M)
    if pattern.search(text):
        return pattern.sub(rf'\g<1>{name} = {value}', text, count=1)
    return text


def render():
    """Copies shipped templates over the package defaults. Site secrets and uploads are never touched."""
    state = load_state()
    templates = os.path.join(APP_ROOT, 'freeradius')
    workgroup = state.get('ad_workgroup', 'WORKGROUP')
    for name in ('default', 'inner-tunnel'):
        write_file(f'{RADDB}/sites-available/{name}', read_bytes(f'{templates}/sites/{name}'), 0o640)
    for name in TEMPLATE_MODS:
        data = mschap_text(workgroup) if name == 'mschap' else read_bytes(f'{templates}/mods/{name}')
        write_file(f'{RADDB}/mods-available/{name}', data, 0o640)
    for name in ENABLED_MODS:
        link = f'{RADDB}/mods-enabled/{name}'
        if not os.path.lexists(link):
            os.symlink(f'../mods-available/{name}', link)
    write_file(f'{RADDB}/policy.d/mac-address.conf', read_bytes(f'{templates}/policy/mac-address.conf'), 0o640)
    radiusd = read_bytes(f'{RADDB}/radiusd.conf').decode()
    radiusd = ensure_setting(radiusd, 'auth', 'yes')
    # TTLS/PAP and GTC passwords are cleartext at this point: they must never reach the log.
    radiusd = ensure_setting(radiusd, 'auth_badpass', 'no')
    radiusd = ensure_setting(radiusd, 'auth_goodpass', 'no')
    if not re.search(r'^[ \t]*correct_escapes[ \t]*=', radiusd, re.M):
        radiusd = radiusd.replace('\nprefix = ', '\ncorrect_escapes = true\nprefix = ', 1)
    write_file(f'{RADDB}/radiusd.conf', radiusd.encode(), 0o640)
    if not os.path.exists(CLIENTS) or b'Managed by radius-manager' not in read_bytes(CLIENTS):
        local = state.setdefault('local_secret', secrets.token_hex(16))
        write_file(CLIENTS, clients_conf('', [], local), 0o640)
    if not os.path.exists(EAP_CERT):
        os.makedirs(EAP_CERT_DIR, exist_ok=True)
        cert, key = self_signed(INITIAL_CERT_SUFFIX)
        write_file(EAP_CERT, cert, 0o640)
        write_file(EAP_KEY, key, 0o640)
        state['eap_cert_auto'] = True
    shutil.chown(EAP_CERT_DIR, 'root', 'freerad')
    os.chmod(EAP_CERT_DIR, 0o750)
    if not os.path.exists(LDAP_CONF) or not os.path.exists(LDAP_CERT):
        cert, key = self_signed('not-configured.invalid', days=3650)
        write_file(LDAP_CONF, placeholder_ldap(), 0o640)
        write_file(LDAP_CERT, cert, 0o640)
        write_file(LDAP_KEY, key, 0o640)
    if not os.path.exists(PROXY_CONF) or b'Managed by radius-manager' not in read_bytes(PROXY_CONF):
        if os.path.exists(PROXY_CONF) and not os.path.exists(PROXY_CONF + '.radmgr-orig'):
            shutil.copy2(PROXY_CONF, PROXY_CONF + '.radmgr-orig')
    write_file(PROXY_CONF, proxy_conf_text(state.get('proxy')), 0o640)
    write_file(PROXY_JSON, proxy_json(state.get('proxy')), 0o640)
    data_file = f'{RADDB}/authorized_macs'
    if not os.path.exists(data_file):
        write_file(data_file, b'', 0o640, SERVICE_USER, 'freerad')
    save_state(state)
    error = config_error()
    if error:
        sys.exit(f'FreeRADIUS config check failed:\n{error}')


if __name__ == '__main__':
    if os.geteuid() != 0:
        sys.exit('must run as root')
    command = sys.argv[1] if len(sys.argv) > 1 else ''
    if command == 'process':
        process()
    elif command == 'render':
        render()
    elif command == 'update-run' and len(sys.argv) == 4 and sys.argv[2] in ('update', 'rollback'):
        update_run(sys.argv[2], sys.argv[3])
    elif command == 'bench-run':
        bench_run()
    else:
        sys.exit(__doc__)
